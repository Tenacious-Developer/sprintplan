{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(npm test)",
      "PowerShell(npm run *)",
      "PowerShell(npx vitest *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "Bash(git pull)",
      "Bash(git merge --squash *)",
      "PowerShell(git pull)",
      "PowerShell(git merge --squash *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "PowerShell(git push *)",
      "PowerShell(git push)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force)",
      "PowerShell(git push * -f)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(Remove-Item * -Recurse *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
